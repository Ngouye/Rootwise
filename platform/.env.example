# Copier en .env puis changer les valeurs (le fichier .env n'est jamais versionné).

# Profils Docker actifs : « app » = API et site en conteneurs (+ « local » pour travailler hors ligne).
COMPOSE_PROFILES=app

# Base de données Supabase : bouton « Connect » > JDBC > Session pooler (infra/supabase/README.md).
# Vide = base PostgreSQL locale (docker compose --profile local up -d).
DB_URL=jdbc:postgresql://aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<référence-du-projet>
DB_PASSWORD=change-me
DB_POOL_SIZE=5

# Fichiers (images, PDF, vidéos) : Supabase Storage, bucket privé « cryptoplatform-media ».
# Clés : Storage > S3 > « New access key ». Vides = SeaweedFS local (--profile local).
S3_ENDPOINT=https://<référence-du-projet>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Le plan gratuit de Supabase refuse les fichiers de plus de 50 Mo.
STORAGE_MAX_VIDEO=50MB

# Clé de signature des sessions (256 bits en Base64) : openssl rand -base64 32
# Vide = clé éphémère régénérée à chaque démarrage (développement uniquement).
JWT_SECRET=

# Adresses promues administrateur dès qu'elles sont vérifiées (séparées par des virgules).
ADMIN_EMAILS=

# URL publique du site (liens des e-mails, retour OAuth).
APP_PUBLIC_URL=http://localhost:3000

# Connexion Google / GitHub : laisser vide pour masquer le bouton.
# URL de retour à déclarer chez le fournisseur : <APP_PUBLIC_URL>/login/oauth2/code/google (ou /github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Clé privée Ed25519 qui signe les certificats (PKCS#8 DER en Base64) :
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
# Vide = clé éphémère (développement) ; les certificats déjà émis restent vérifiables.
CERT_SIGNING_KEY=

# Deux cours d'exemple créés au premier démarrage (laisser à false sur une base qui reçoit des données).
DEMO_DATA=false
